# Copy to .env and fill in. .env is gitignored — never commit real keys or the DB URL.

# LLM provider (Anthropic for prod; OpenAI optional for parity with the AIE cert)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings (Voyage recommended; OpenAI text-embedding-3-small is fine to start)
VOYAGE_API_KEY=

# Postgres + pgvector. Using Supabase (managed Postgres in the cloud).
# Connection -> Session pooler, Type URI (IPv4-friendly, works cleanly with psycopg).
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Models (swap freely — these are behind interfaces)
CHAT_MODEL=claude-sonnet-4-6
REASONING_MODEL=claude-opus-4-8
CHEAP_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# Optional: LangSmith tracing (good production hygiene)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=cumulus
