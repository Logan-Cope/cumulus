# Copy to .env and fill in. .env is gitignored.

# LLM provider (Anthropic for prod; OpenAI optional for parity with the AIE cert)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings (Voyage recommended; OpenAI text-embedding-3-small is fine to start)
VOYAGE_API_KEY=

# Postgres + pgvector (single DB for app data, memory, audit, and vectors)
DATABASE_URL=postgresql://localhost:5432/cumulus

# Models (swap freely — these are behind interfaces)
CHAT_MODEL=claude-sonnet-4-6
REASONING_MODEL=claude-opus-4-8
CHEAP_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=voyage-3

# Optional: LangSmith tracing (good production hygiene)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=cumulus
